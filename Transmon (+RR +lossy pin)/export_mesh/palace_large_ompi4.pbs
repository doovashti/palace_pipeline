#!/bin/bash
#PBS -r n
#PBS -N palace_large_ompi4
#PBS -l select=1:ncpus=36:mpiprocs=36:ompthreads=1:mem=48gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -uo pipefail
cd "$PBS_O_WORKDIR" || exit 1

module purge
module load gcc11/11.3.0
module load openblas/dynamic/0.3.18
module load openmpi

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export FI_PROVIDER=tcp

NCPUS=$(wc -l < "$PBS_NODEFILE")

echo "PBS_JOBID = $PBS_JOBID"
echo "PBS_NODEFILE = $PBS_NODEFILE"
echo "NCPUS = $NCPUS"
echo "--- nodefile ---"
cat "$PBS_NODEFILE"

echo "--- MPI ---"
which mpirun
mpirun --version | head -3

echo "--- Palace binary ---"
ls -lh ~/palace_build_openmpi/bin/palace-x86_64.bin

echo "--- Running Palace OpenMPI parallel ---"
mpirun -np "$NCPUS" -hostfile "$PBS_NODEFILE" \
  ~/palace_build_openmpi/bin/palace-x86_64.bin \
  palace_config.json
